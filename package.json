{
  "name": "olivenernte-app",
  "version": "1.0.0",
  "description": "Offline-fähige Karten-App für die Olivenernte",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "type": "module",
  "dependencies": {
    "@turf/bbox": "^7.4.0",
    "@turf/kinks": "^7.4.0",
    "dexie": "^4.4.6",
    "maplibre-gl": "^6.11.2",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@preact/preset-vite": "^2.10.6",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "eslint": "^10.11.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.12.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.2"
  },
  "private": true
}
